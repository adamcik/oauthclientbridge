{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adamcik/renovate-config:application",
    "github>adamcik/renovate-config:automerge"
  ],
  "nix": {
    "enabled": true
  },
  "labels": ["dependencies"],
  "ignorePaths": ["deploy/**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 06:00 on the first day of the month"]
  },
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "overrideDepName": "uv lock file maintenance",
      "groupName": "uv lock file maintenance",
      "commitMessageTopic": "uv"
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "overrideDepName": "flake lock file maintenance",
      "groupName": "flake lock file maintenance",
      "commitMessageTopic": "flake"
    },
    {
      "matchManagers": ["github-actions", "nix"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "opentelemetry",
      "matchPackageNames": [
        "/^opentelemetry-/"
      ]
    },
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": [
        "/^opentelemetry-instrumentation-/"
      ],
      "ignoreUnstable": false
    },
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": ["pydantic", "pydantic-settings"],
      "groupName": "pydantic"
    },
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": ["flask", "werkzeug", "jinja2", "itsdangerous"],
      "groupName": "flask stack"
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["patch"],
      "groupName": "python patch updates",
      "automerge": true,
      "automergeType": "pr",
      "schedule": ["before 06:00 on Saturday"]
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
