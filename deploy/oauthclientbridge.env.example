# Required app settings
BRIDGE_SESSION_SECRET=replace-me
# DB_DATABASE=/data/sqlite.db
OAUTH_CLIENT_ID=replace-me
OAUTH_CLIENT_SECRET=replace-me
OAUTH_AUTHORIZATION_URI=https://provider.example.com/auth
OAUTH_TOKEN_URI=https://provider.example.com/token

# Optional bridge settings
# BRIDGE_SESSION_COOKIE_SECURE=true
# BRIDGE_SESSION_COOKIE_DOMAIN=auth.example.com
# BRIDGE_SESSION_COOKIE_PATH=/provider

# Optional Sentry
# SENTRY_ENABLED=true
# SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/1
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE_OVERRIDES={"/metrics": 0.1}

# OpenTelemetry (optional)
# TELEMETRY_COMPONENTS=tracing,metrics
# TELEMETRY_EXPORTERS=otlp_http
# TELEMETRY_ENDPOINT=http://otel-collector:4318
# TELEMETRY_SERVICE_NAME=oauthclientbridge

# Prometheus multiprocess mode (required if running multiple workers/processes)
# PROMETHEUS_MULTIPROC_DIR=/run/prom

# Optional callback template override
# BRIDGE_CALLBACK_TEMPLATE_FILE=/config/callback.html

# Container runtime knobs consumed by image entrypoint
WORKERS=4
THREADS=2
# Seconds Uvicorn drains active requests after it stops accepting connections.
# Keep this greater than FETCH_TOTAL_TIMEOUT and below the service stop timeout.
ASGI_GRACEFUL_SHUTDOWN_TIMEOUT=25
