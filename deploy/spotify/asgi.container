[Unit]
Description=OAuth Client Bridge ASGI canary (Spotify)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=oauthclientbridge-spotify-asgi
Image=ghcr.io/adamcik/oauthclientbridge:asgi
Network=host

EnvironmentFile=/etc/oauthclientbridge/spotify/asgi.env

User=124:33

ReadOnly=true
DropCapability=all

Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=256m,mode=1777
Tmpfs=/run/prom:rw,size=64m,mode=0777
Volume=/var/lib/oauthclientbridge/spotify:/data:Z
Volume=/run/oauthclientbridge/spotify:/run/asgi:Z
Volume=/etc/oauthclientbridge/spotify/callback.html:/config/callback.html:ro,Z

Exec=--uds /run/asgi/uvicorn.sock

[Service]
Restart=always
RestartSec=5
# Leaves 20 seconds after Uvicorn's 25-second request drain for ASGI cleanup.
TimeoutStopSec=45
NoNewPrivileges=yes

# /run is tmpfs; recreate on each start
ExecStartPre=/usr/bin/install -d -o root -g www-data -m 2775 /run/oauthclientbridge/spotify

[Install]
WantedBy=multi-user.target
